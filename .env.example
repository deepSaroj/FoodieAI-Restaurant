# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to GitHub.

# Random secret for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# Optional: OpenAI-compatible API key for the chatbot's "AI mode".
# Leave empty to use the built-in rule-based chatbot (works fully offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default admin account created on first run (change after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
